generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String           @id @default(uuid())
  email                  String           @unique
  name                   String?
  trialUsed              Boolean          @default(false) @map("trial_used")
  plan                   String           @default("pay_per_book") @map("plan")
  planPeriodStart        DateTime?        @map("plan_period_start")
  subscriptionId         String?          @map("subscription_id")
  lemonSqueezyCustomerId String?          @map("lemonsqueezy_customer_id")
  currentPeriodEnd       DateTime?        @map("current_period_end")
  subscriptionStatus     String?          @map("subscription_status")
  createdAt              DateTime         @default(now()) @map("created_at")
  books                  Book[]
  puzzles                PuzzleRegistry[]

  @@map("users")
}

model SeedCounter {
  difficulty String @id
  nextSeed   BigInt @default(1) @map("next_seed")

  @@map("seed_counters")
}

model PuzzleRegistry {
  id         String    @id @default(uuid())
  seed       BigInt    @unique
  hash       String    @unique @db.Char(64)
  difficulty String
  status     String    @default("available")
  userId     String?   @map("user_id")
  bookId     String?   @map("book_id")
  reservedAt DateTime? @map("reserved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User?     @relation(fields: [userId], references: [id])
  book       Book?     @relation(fields: [bookId], references: [id])

  @@map("puzzle_registry")
}

model Book {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  title       String?
  trimSize    String           @map("trim_size")
  difficulty  String
  pageCount   Int              @map("page_count")
  layout      Int              @default(1)
  frontMatter Json?            @map("front_matter")
  status      String           @default("draft")
  pdfPath     String?          @map("pdf_path")
  expiresAt   DateTime?        @map("expires_at") // TODO: remove this field when we implement a subscription system
  createdAt   DateTime         @default(now()) @map("created_at")
  user        User             @relation(fields: [userId], references: [id])
  puzzles     PuzzleRegistry[]

  @@map("books")
}
